{
  "rules": {
    ".read": false,
    ".write": false,
    "operators": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
    },
    "rooms": {
      "jokes-on-me-live-2026": {
        "control": {
          "submitOpen": {
            ".read": true,
            ".write": "auth != null && (auth.token.email === 'stage-admin@jokes-on-me-3437e.firebaseapp.com' || root.child('operators').child(auth.uid).val() === true) && newData.exists()",
            ".validate": "newData.isBoolean()"
          }
        },
        "moderation": {
          ".read": "auth != null && (auth.token.email === 'stage-admin@jokes-on-me-3437e.firebaseapp.com' || root.child('operators').child(auth.uid).val() === true)",
          "$id": {
            ".write": "auth != null && (auth.token.email === 'stage-admin@jokes-on-me-3437e.firebaseapp.com' || root.child('operators').child(auth.uid).val() === true) && root.child('rooms/jokes-on-me-live-2026/responses').child($id).exists() && newData.exists()",
            ".validate": "newData.hasChildren(['state','at','by'])",
            "state": { ".validate": "newData.val() === 'active' || newData.val() === 'ignored' || newData.val() === 'archived'" },
            "at": { ".validate": "newData.isNumber() && newData.val() === now" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "$other": { ".validate": false }
          }
        },
        "responses": {
          ".read": "auth != null && (auth.token.email === 'stage-admin@jokes-on-me-3437e.firebaseapp.com' || root.child('operators').child(auth.uid).val() === true)",
          "$id": {
            ".write": "!data.exists() && newData.exists() && root.child('rooms/jokes-on-me-live-2026/control/submitOpen').val() === true",
            ".validate": "newData.hasChildren(['table','nick','tags','photo','romanticGesture','awkwardLine','location','igStory','ts'])",
            "table": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "nick": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "tags": {
              ".validate": "newData.hasChildren(['0','1','2'])",
              "$index": { ".validate": "($index === '0' || $index === '1' || $index === '2') && newData.isString() && newData.val().length > 0 && newData.val().length <= 20" }
            },
            "photo": { ".validate": "newData.isString() && newData.val().length <= 512000 && newData.val().beginsWith('data:image/jpeg;base64,')" },
            "romanticGesture": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48" },
            "awkwardLine": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48" },
            "location": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "igStory": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "ts": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
